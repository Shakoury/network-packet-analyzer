# Environment Configuration Template

# Flask Configuration
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///analyzer.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/analyzer_db

# Packet Capture
DEFAULT_INTERFACE=eth0
PACKET_TIMEOUT=30
PACKET_BUFFER_SIZE=10000

# Threat Detection
THREAT_THRESHOLD=30
SCAN_INTERVAL=5

# API Configuration
API_DEBUG=False
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/analyzer.log

# Security
ENABLE_AUTH=False
SESSION_TIMEOUT=3600
